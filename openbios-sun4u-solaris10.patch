 			PUSH(pointer2cell(drive));
 			feval("value drive");
 
@@ -1489,7 +1558,9 @@ int ob_ide_init(const char *path, uint32_t io_port0, uint32_t ctl_port0,
 				set_hd_alias(nodebuff);
 		}
 
