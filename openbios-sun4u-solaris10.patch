+#ifndef CONFIG_SPARC64
 static void
 ob_ide_ctrl_decodeunit(int *idx)
 {
@@ -1308,6 +1314,44 @@ NODE_METHODS(ob_ide_ctrl) = {
 	{ "dma-map-out",	ob_ide_dma_map_out	},
 	{ "dma-sync",		ob_ide_dma_sync		},
 };
+#endif
+
+#ifdef CONFIG_SPARC64
+/* Solaris identifies IDE drives directly below the PCI controller as
+ * disk@target,lun and cdrom@target,lun.  Channel one starts at target 2. */
+static void ob_ide_sparc64_decode_unit(int *idx)
+{
+	char *unit = pop_fstr_copy();
+	char *end;
+	ucell target = strtol(unit, &end, 16);
+	ucell lun = (*end == ',') ? strtol(end + 1, NULL, 16) : 0;
+
+	free(unit);
+	PUSH(lun);
+	PUSH(target);
+}
+
+static void ob_ide_sparc64_encode_unit(int *idx)
+{
+	char unit[32];
+	ucell target = POP();
+	ucell lun = POP();
+
+	snprintf(unit, sizeof(unit), "%x,%x", (unsigned int)target,
+	         (unsigned int)lun);
+	push_str(unit);
+}
+
+NODE_METHODS(ob_ide_sparc64_bus) = {
+	{ "decode-unit", ob_ide_sparc64_decode_unit },
+	{ "encode-unit", ob_ide_sparc64_encode_unit },
+	{ "dma-alloc", ob_ide_dma_alloc },
+	{ "dma-free", ob_ide_dma_free },
+	{ "dma-map-in", ob_ide_dma_map_in },
+	{ "dma-map-out", ob_ide_dma_map_out },
+	{ "dma-sync", ob_ide_dma_sync },
+};
