 		for (j = 0; j < 2; j++) {
 			struct ide_drive *drive = &chan->drives[j];
@@ -1464,13 +1519,27 @@ int ob_ide_init(const char *path, uint32_t io_port0, uint32_t ctl_port0,
 
 			fword("new-device");
 			dnode = get_cur_dev();
+#ifdef CONFIG_SPARC64
+			props[0] = __cpu_to_be32(i * 2 + j);
+			props[1] = 0;
+			set_property(dnode, "reg", (char *)props, 2*sizeof(props[0]));
