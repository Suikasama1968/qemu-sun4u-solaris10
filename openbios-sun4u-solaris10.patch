+    { "pci-map-in",  ob_pci_bridge_map_in  },
+    { "dma-alloc",   ob_pci_dma_alloc      },
+    { "dma-free",    ob_pci_dma_free       },
+    { "dma-map-in",  ob_pci_dma_map_in     },
+    { "dma-map-out", ob_pci_dma_map_out    },
