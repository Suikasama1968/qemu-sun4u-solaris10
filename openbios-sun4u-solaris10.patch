+\ QEMU sun4u has no Automatic System Recovery database.  Solaris expects
+\ a length of -1 when these firmware services are unavailable.
+: SUNW,asr-export-len ( -- len )
+  -1
+;
+
+: SUNW,asr-list-keys-len ( -- len )
+  -1
+;
+
+: SUNW,asr-export ( buffer -- len )
+  drop -1
+;
+
+: SUNW,asr-list-keys ( buffer -- len )
+  drop -1
+;
+
