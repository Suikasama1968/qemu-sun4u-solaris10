diff --git a/arch/sparc64/tree.fs b/arch/sparc64/tree.fs
index f390f6c..98e4621 100644
--- a/arch/sparc64/tree.fs
+++ b/arch/sparc64/tree.fs
@@ -6,9 +6,13 @@ include config.fs
 
 : decode-unit-upa ( str len -- id lun )
   2 parse-nhex
+  \ Sabre has reg id 1fe, but Solaris names it pci@1f,0.
+  dup h# 1f = if drop h# 1fe then
 ;
 
 : encode-unit-upa ( id lun -- str len)
+  \ Keep the firmware path in sync with Solaris's Sabre device path.
+  dup h# 1fe = if drop h# 1f then
   swap
   pocket tohexstr
   " ," pocket tmpstrcat >r
