+/* The EBus child address consists of a BAR register and an offset. */
+static void ob_ebus_decode_unit(int *idx)
+{
+    char *unit = pop_fstr_copy();
+    char *end;
+    ucell bar = strtol(unit, &end, 16);
+    ucell offset = (*end == ',') ? strtol(end + 1, NULL, 16) : 0;
+
+    free(unit);
+    PUSH(offset);
+    PUSH(bar);
+}
+
+static void ob_ebus_encode_unit(int *idx)
+{
+    char unit[32];
+    ucell bar = POP();
+    ucell offset = POP();
+
+    snprintf(unit, sizeof(unit), "%x,%x", (unsigned int)bar,
+             (unsigned int)offset);
+    push_str(unit);
+}
