diff --git a/arch/sparc64/call-client.S b/arch/sparc64/call-client.S
index 4129505..786ca51 100644
--- a/arch/sparc64/call-client.S
+++ b/arch/sparc64/call-client.S
@@ -44,6 +44,12 @@ sparc64_of_client_interface:
 	stx	%g6, [%sp + 2047 - 248 + 232]
 	stx	%g7, [%sp + 2047 - 248 + 240]
 
+	/* Keep the incoming PSTATE beside the saved globals. */
+	rdpr	%pstate, %g2
+	stx	%g2, [%sp + 2047 - 64]
+	andn	%g2, 2, %g3
+	wrpr	%g3, %pstate
+
 	/* Save existing stack */
 	setx	client_stack, %g6, %g7
 	stx	%sp, [%g7]
@@ -75,7 +81,12 @@ sparc64_of_client_interface:
 	add	%g7, 8, %g7
 	stx	%g7, [%g1 + 0x4d0]
 	
-	SAVE_CPU_STATE(cif)
+	SAVE_CPU_GENERAL_STATE(cif)
+	/* GENERAL_STATE saw IE cleared; retain the original client state. */
+	ldx	[%sp + 2047 - 64], %g7
+	stx	%g7, [%g1 + 0xb0]
+	SAVE_CPU_WINDOW_STATE(cif)
+	SAVE_CPU_TRAP_STATE(cif)
 	
 	RESET_CPU_WINDOW_STATE(cif)
 	
@@ -97,10 +108,19 @@ sparc64_of_client_interface:
 	add	%g1, %g7, %g7
 	mov	%g7, %sp
 
+	/* Restore the incoming interrupt policy for normal CIF execution. */
+	ldx	[%g1 + 0xb0], %g7
+	wrpr	%g7, %pstate
+
 	/* Call client inteface */
 	call of_client_interface
 	 ldx	[%g1 + 0x70], %o0
 
+	/* Do not take an interrupt with a partially restored register file. */
+	rdpr	%pstate, %g2
+	andn	%g2, 2, %g3
+	wrpr	%g3, %pstate
+
 	/* Restore windows */
 	setx	_fcstack_ptr, %g6, %g7
 	ldx	[%g7], %g1
@@ -117,7 +137,16 @@ sparc64_of_client_interface:
 	setx	__context, %g6, %g7
 	stx	%g3, [%g7]
 	
-	RESTORE_CPU_STATE(cif)
+	/* Restore general state while keeping IE clear until globals are valid. */
+	ldx	[%g1 + 0xb0], %g7
+	andn	%g7, 2, %g7
+	wrpr	%g7, %pstate
+	ldx	[%g1 + 0xb8], %g7
+	wr	%g7, 0, %y
+	ldx	[%g1 + 0xc0], %g7
+	wr	%g7, 0, %fprs
+	RESTORE_CPU_WINDOW_STATE(cif)
+	RESTORE_CPU_TRAP_STATE(cif)
 	
 	add	%g1, CONTEXT_STATE_SIZE, %g5
 	setx	_fcstack_ptr, %g6, %g7
@@ -131,12 +160,16 @@ sparc64_of_client_interface:
 	ldx	[%g1 + 0x4d0], %o7
 	
 	/* Restore globals */
-	ldx	[%g1 + 0x38], %g2
 	ldx	[%g1 + 0x40], %g3
 	ldx	[%g1 + 0x48], %g4 
 	ldx	[%g1 + 0x50], %g5 
 	ldx	[%g1 + 0x58], %g6
 	ldx	[%g1 + 0x60], %g7
 	
+	/* SP, windows and g7 are now the client's again. */
+	ldx	[%g1 + 0xb0], %g2
+	wrpr	%g2, %pstate
+	ldx	[%g1 + 0x38], %g2
+
 	jmp	%o7
 	 ldx	[%g1 + 0x30], %g1
diff --git a/arch/sparc64/init.fs b/arch/sparc64/init.fs
